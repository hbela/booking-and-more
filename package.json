{
  "name": "booking-and-more",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant appointment-booking SaaS",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\"",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "db:generate": "pnpm --filter @bam/db db:generate",
    "db:migrate": "pnpm --filter @bam/db db:migrate",
    "db:migrate:deploy": "pnpm --filter @bam/db db:migrate:deploy",
    "db:drift-check": "pnpm --filter @bam/db db:drift-check",
    "db:studio": "pnpm --filter @bam/db db:studio",
    "db:grant-platform-admin": "pnpm --filter @bam/db db:grant-platform-admin",
    "db:join-tenant": "pnpm --filter @bam/db db:join-tenant",
    "db:discard-organization": "pnpm --filter @bam/db db:discard-organization",
    "db:explain-availability": "pnpm --filter @bam/db db:explain-availability"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@prisma/config>deepmerge-ts": "8.0.0",
      "brace-expansion@5.0.8": "5.0.9",
      "fast-uri@3.1.4": "3.1.5",
      "fast-uri@4.1.1": "4.1.2",
      "nanoid@3.3.16": "3.3.18"
    }
  }
}
