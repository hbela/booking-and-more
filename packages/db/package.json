{
  "name": "@bam/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "check-types": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:drift-check": "node ./scripts/drift-check.mjs",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:grant-platform-admin": "tsx ./scripts/grant-platform-admin.ts",
    "db:join-tenant": "tsx ./scripts/join-tenant.ts",
    "db:discard-organization": "tsx ./scripts/discard-organization.ts",
    "db:explain-availability": "tsx ./scripts/explain-availability.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1"
  },
  "devDependencies": {
    "@bam/availability-engine": "workspace:*",
    "@bam/booking-engine": "workspace:*",
    "@bam/config": "workspace:*",
    "@bam/eslint-config": "workspace:*",
    "@bam/notification-engine": "workspace:*",
    "@bam/tsconfig": "workspace:*",
    "@prisma/config": "^7.9.1",
    "@types/node": "catalog:",
    "dotenv": "^17.4.2",
    "eslint": "catalog:",
    "prisma": "^7.9.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
