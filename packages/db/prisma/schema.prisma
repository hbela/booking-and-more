model OutboxEvent {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// BOOKING_CONFIRMED, BOOKING_CANCELLED, … Deliberately a string rather than
  /// an enum: adding an event type should not need a migration, and the worker
  /// ignores what it does not recognise.
  eventType String @map("event_type")

  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id")

  payload Json @map("payload_json")

  status OutboxStatus @default(PENDING)

  /// Lets an event be scheduled rather than sent at once — a reminder the day
  /// before, for instance.
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  attempts    Int      @default(0)
  lastError   String?  @map("last_error")

  /// When a dispatcher took this row. Without it, a worker killed mid-batch
  /// leaves rows PROCESSING forever: nothing distinguishes "being worked on
  /// right now" from "claimed by a process that no longer exists". The claim
  /// query treats a stale timestamp as abandoned and takes the row back.
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  /// The worker's claim query: everything due and unsent, oldest first.
  @@index([status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH

  @@map("notification_channel")
}

/// What happened, not which template rendered it. A tenant that later wants a
/// different confirmation wording changes `template`; this stays the same, so
/// "how many confirmations did we send" survives a copy rewrite.
enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_UPDATED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  CALENDAR_DISCONNECTED
  /// Sent to a newly provisioned organization's owner, carrying their
  /// single-use acceptance link (phase-9 §2.5). Appended rather than inserted:
  /// PostgreSQL can only add enum values at the end without recreating the type.
  ORGANIZATION_CREATED
  /// The owner's Stripe payment link, emailed so it can be forwarded to
  /// whoever holds the company card (phase-9-subscription-and-activation.md
  /// §1.1). Appended, for the same reason as the value above.
  SUBSCRIPTION_LINK
  /// Three days before a free trial converts to a paid subscription
  /// (phase-9-subscription-lifecycle.md §2.1). The card is already on file, so
  /// this is a courtesy — and a charge nobody expected is the commonest reason
  /// a new customer disputes one. Appended, as above.
  TRIAL_ENDING_SOON
  /// A renewal was declined. Access continues while Stripe retries, so this
  /// exists to get the card fixed before dunning runs out and the organization
  /// is suspended (§2.3). Appended, as above.
  SUBSCRIPTION_PAYMENT_FAILED
  /// The subscription went live — the receipt for the whole onboarding path.
  ///
  /// Sent once per Stripe subscription, ever, which is why its dedupe key is
  /// the subscription id rather than the outbox event: `customer.subscription.*`
  /// fires on every later change and each one would otherwise earn an email.
  ///
  /// It closes the loop the payment link opened. Until this existed the owner
  /// paid on Stripe's page and heard nothing from us again — the one moment in
  /// onboarding where silence reads as failure, because they have just been
  /// charged. Appended, as above.
  SUBSCRIPTION_CONFIRMED

  /// A provider invited to set up their own login, carrying the single-use link
  /// that also links their membership to their diary
  /// (phase-9-provider-onboarding §2.8). Appended, as above.
  PROVIDER_INVITED
  /// Somebody with no account yet, invited to assist on one provider's diary
  /// (docs/phase-3-4-diary-delegation.md §2.13). Appended, as every value here
  /// must be: PostgreSQL can only add enum values at the end.
  ASSISTANT_INVITED

  /// A booking for a service with `requiresApproval`: received, not yet
  /// accepted. Its own type rather than a second BOOKING_CONFIRMATION template,
  /// because that type's dedupe key is one-per-booking-forever and the
  /// acceptance email that follows would collide with the request email and be
  /// swallowed (docs/phase-5-booking-notifications.md §2.4). Appended, as above.
  BOOKING_REQUESTED

  @@map("notification_type")
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  /// Deliberately not FAILED. A booking taken over the phone with no email
  /// address has nothing to send to, and that is a correct outcome — treating
  /// it as a failure would fill a dead-letter queue with bookings that are fine.
  SKIPPED

  @@map("notification_status")
}

/// tech-impl §27.
///
/// One row per message the platform owes someone, written before anything is
/// sent and updated as delivery progresses. It is the delivery-tracking record
/// and the deduplication key at once.
///
/// Epic 5's exit criterion is that duplicate events do not send duplicate
/// messages, and `dedupeKey` is how that is enforced: the unique index refuses
/// the second row, so a redelivered outbox event, a retried job and a
/// double-clicked confirmation all collapse to one email. Application code
/// translates the unique violation into "already handled" — it does not SELECT
/// first and hope, for the same reason capacity reservations do not
/// (CLAUDE.md rule 14).
model Notification {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Nullable because not every notification is about a booking — a calendar
  /// disconnection is addressed to staff.
  bookingId String?  @map("booking_id")
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  type    NotificationType
  channel NotificationChannel @default(EMAIL)

  /// The address as it was at send time. Snapshotted for the same reason the
  /// booking snapshots its price (rule 15): "where did we actually send this"
  /// must survive the customer later changing their email.
  recipient String

  /// Template identifier, e.g. `booking-confirmation`. Resolved by
  /// @bam/notification-engine; a string rather than an enum so adding a
  /// template is not a migration.
  template String
  /// BCP-47, resolved from the customer then the tenant.
  locale   String

  status NotificationStatus @default(PENDING)

  /// The provider's id for this message, kept so a delivery webhook or a
  /// support question can be traced back to a row.
  providerMessageId String? @map("provider_message_id")

  attempts  Int     @default(0)
  lastError String? @map("last_error")

  /// When a sender claimed this row. A stale SENDING claim is returned to the
  /// queue by the notification sweeper after a worker crash.
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(3)

  /// When it should go out. Now for a confirmation, hours ahead for a reminder.
  scheduledAt DateTime  @map("scheduled_at") @db.Timestamptz(3)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(3)

  /// Stable identity of "this message, for this thing, once" — built by
  /// @bam/notification-engine so the rule lives in one testable place.
  dedupeKey String @map("dedupe_key")

  /// Values the template needs that cannot be re-derived at send time.
  ///
  /// Almost every notification re-reads its subject from the database when the
  /// job runs, which is why a confirmation reflects the booking as it is now.
  /// A provisioning email cannot: it carries a single-use invitation link, and
  /// the invitation stores only a SHA-256 hash (tech-impl §34.4), so the raw
  /// token exists nowhere else. It is held here and cleared on successful
  /// send, which bounds the exposure to the seconds a queued job waits.
  payload Json? @map("payload_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The exit criterion, as a constraint.
  @@unique([tenantId, dedupeKey])
  /// The sender's claim query: everything due and unsent.
  @@index([status, scheduledAt])
  @@index([tenantId, bookingId])
  @@map("notifications")
}

/// tech-impl §32.
///
/// A customer on a hotel wifi taps "Confirm", the response is lost, and the
/// retry must return the first booking rather than make a second one. The key
/// is the client's; `requestHash` is ours, so that reusing a key with a
/// different payload is refused rather than silently answered with the wrong
/// booking.
model IdempotencyKey {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key       String
  /// The route this key was used for. Scoped so that one client-generated key
  /// reused across two different operations does not collide.
  operation String

  requestHash String @map("request_hash")

  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ===========================================================================
// Billing — docs/phase-9-saas-administration.md
// ===========================================================================

enum SubscriptionPlan {
  /// Not sold. Demo and internal organizations carry this so that "which plan
  /// is this tenant on" never returns nothing, and so quota enforcement has
  /// something to read (phase-9 §2.2).
  INTERNAL
  STARTER
  PROFESSIONAL

  @@map("subscription_plan")
}

/// Mirrors Stripe's subscription statuses. A string enum rather than free text
/// so an unrecognised value from a webhook is a loud failure, not a silent one.
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
  /// INTERNAL plans, which have no Stripe counterpart to be a status of.
  NOT_APPLICABLE

  @@map("subscription_status")
}

/// What the tenant is paying for. phase-9 §2.7.
///
/// Stripe is the source of truth for money; this mirrors only what the
/// application acts on — whether writes are allowed, which plan's quotas apply,
/// and enough identifiers to deep-link into Stripe from the admin dashboard.
/// Anything else is read from Stripe on demand rather than synchronised.
model Subscription {
  id String @id @default(cuid(2))

  /// One per tenant. The unique constraint is load-bearing: it is what stops a
  /// redelivered Stripe webhook creating a second subscription for one payment
  /// (CLAUDE.md rule 14 — the database decides, application code translates).
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan
  status SubscriptionStatus @default(NOT_APPLICABLE)

  /// Nullable so an INTERNAL subscription can exist with no Stripe counterpart.
  /// PostgreSQL allows repeated NULLs under a unique index, so this still
  /// refuses two tenants claiming one real Stripe subscription.
  stripeCustomerId     String? @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")

  /// What was actually bought. The plan is resolved *from* this, mapped through
  /// STRIPE_PRICE_* config (phase-9-subscription-lifecycle.md §2.4); stored so a
  /// wrong plan is diagnosable without opening Stripe.
  stripePriceId String? @map("stripe_price_id")

  currentPeriodEnd  DateTime? @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")

  /// Last Stripe subscription-state event applied to this mirror. Stripe does
  /// not guarantee delivery order, so older events must not overwrite newer
  /// status, plan, period, or tenant-access state.
  lastStripeStateEventAt DateTime? @map("last_stripe_state_event_at") @db.Timestamptz(3)
  lastStripeStateEventId String?   @map("last_stripe_state_event_id")

  /// Schedule events mutate a separate slice of the mirror and therefore need
  /// their own ordering cursor; a subscription update must not suppress a
  /// legitimate schedule update that happened slightly earlier.
  lastStripeScheduleEventAt DateTime? @map("last_stripe_schedule_event_at") @db.Timestamptz(3)
  lastStripeScheduleEventId String?   @map("last_stripe_schedule_event_id")

  // --- Trial (phase-9-subscription-lifecycle.md §2.1, §5) -------------------

  /// When the free trial ends. Stripe's `trial_end`, mirrored — the screen
  /// counts down to this rather than to TRIAL_PERIOD_DAYS, which is only copy.
  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz(3)

  /// Set the first time this organization starts a trial, and never overwritten.
  ///
  /// It lives here rather than on Tenant because this row survives cancellation
  /// — `customer.subscription.deleted` sets the status to CANCELED and keeps it
  /// — which is exactly the case it answers: an owner who cancels and
  /// resubscribes must not receive another thirty free days. `requestPaymentLink`
  /// reads it to choose between the trial and no-trial Payment Link.
  trialUsedAt DateTime? @map("trial_used_at") @db.Timestamptz(3)

  // --- Scheduled plan change (§2.4, guide §4) -------------------------------
  //
  // A downgrade does not change the subscription; Stripe attaches a *schedule*
  // whose next phase carries the new price. Mirrored so the screen can say
  // "Professional until 18 September, then Starter" rather than showing a plan
  // the owner has already changed and cannot see they changed.

  /// The `sub_sched_…` attached to this subscription, so its events can be
  /// recognised and its effects cleared when it is released.
  stripeScheduleId String? @map("stripe_schedule_id")

  pendingPlan         SubscriptionPlan? @map("pending_plan")
  pendingPlanStartsAt DateTime?         @map("pending_plan_starts_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("subscriptions")
}

/// The one outstanding checkout link for an organization.
/// docs/phase-9-duplicate-subscription-prevention.md §4.
///
/// ## Why this is not a column on Subscription
///
/// Because at the moment a link is issued there is no Subscription row, and
/// that is the whole bug this table exists to fix. The row is written by
/// `activate()` when `checkout.session.completed` is processed — so a guard
/// that reads it is asking the payment path whether the payment path has
/// finished, and gets "no" for as long as the webhook is late. One tenant
/// reached three live Stripe subscriptions through that window.
///
/// This row is written *before* the customer is sent anywhere, so it exists
/// during exactly the interval in which nothing else does.
///
/// ## What `@unique` on tenantId buys
///
/// One outstanding link per organization, decided by PostgreSQL rather than by
/// a read-then-write in the service (rule 14). Two concurrent `POST /subscribe`
/// calls — the double-clicked button — produce one row and one link, and the
/// loser is told to use the winner's. Without it both would mint a link, and a
/// per-link limit of one completed session would then permit two payments.
///
/// The Stripe-side half of the same constraint is
/// `restrictions.completed_sessions.limit = 1` on the link itself, which is the
/// only guard actually standing on the path between the customer's browser and
/// Stripe's hosted page. Neither half is sufficient alone: this one stops two
/// links existing, that one stops one link being used twice.
model SubscriptionCheckoutLink {
  id String @id @default(cuid(2))

  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// What this link sells. A change of mind before paying deactivates the link
  /// in Stripe and replaces this row, rather than leaving two buyable links.
  plan SubscriptionPlan

  /// Whether this link was issued with a free trial, so the emailed copy and
  /// the screen can agree about whether anything is charged today.
  trial Boolean @default(false)

  /// `plink_…`. Kept so the link can be deactivated on a plan change, and so a
  /// customer stranded by a burnt link can be diagnosed without guessing.
  stripePaymentLinkId String @unique @map("stripe_payment_link_id")

  /// The URL as sent, `client_reference_id` and all. Stored rather than rebuilt
  /// so a second request returns the identical link — a regenerated URL that
  /// merely looks the same is a second link as far as Stripe is concerned.
  url String

  /// Set when `checkout.session.completed` is attributed to this link. The row
  /// is kept rather than deleted: "this organization already paid through this
  /// link" is the fact a duplicate investigation needs, and deleting it would
  /// make a burnt link indistinguishable from one that never existed.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("subscription_checkout_links")
}

/// Webhook idempotency. phase-9 §2.9.
///
/// Stripe delivers at-least-once and retries for days, so a handler that is not
/// idempotent eventually runs twice. The predecessor (`booking-for-all`) had no
/// table like this and acted on every delivery, which meant a redelivered
/// `checkout.session.completed` re-ran activation and re-sent notifications.
///
/// The primary key is Stripe's own event id: inserting is the claim, and a
/// duplicate key means another delivery already has it.
model StripeEvent {
  /// Stripe's `evt_…` id, not ours.
  id String @id

  type String

  payload Json @map("payload_json")

  /// Stripe's event creation time, distinct from when our webhook received it.
  /// Claims are ordered by this value so a backlog naturally applies oldest
  /// state first; subscription cursors still enforce correctness under retry.
  eventCreatedAt DateTime @default(now()) @map("event_created_at") @db.Timestamptz(3)
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  /// Durable processing lease. A second worker cannot take a live claim, while
  /// an abandoned claim becomes eligible again after the stale-claim window.
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  lastError   String?   @map("last_error")

  @@index([processedAt, claimedAt, eventCreatedAt])
  @@map("stripe_events")
}

// ===========================================================================
// Google Calendar — Epic 6, part 1
//
// docs/phase-6-google-calendar-part-1.md. Bookings are written *to* a
// provider's calendar; nothing is read back yet, and working hours are never
// written at all (§2.1).
//
// The database stays authoritative for bookings (PRD §9.10): everything below
// is a mirror, and a mirror that fails to update never changes a booking.
// ===========================================================================

/// Only Google in the MVP. PRD §23.2 excludes other providers; Outlook and
/// Apple are §29 future work. An enum rather than a string so adding one is a
/// deliberate migration.
enum CalendarProviderType {
  GOOGLE

  @@map("calendar_provider_type")
}

/// Three values, deliberately. `lastError` carries the detail; a fourth state
/// would be a second place to ask "can this integration do work".
enum CalendarIntegrationStatus {
  ACTIVE
  /// The grant is gone — revoked at Google, or a refresh token that no longer
  /// works. Nothing retries; a human must re-consent. Set on `invalid_grant`,
  /// 401, and 403 insufficientPermissions.
  NEEDS_RECONNECT
  /// The user's own act. Distinguished from NEEDS_RECONNECT because one is a
  /// failure to report and the other is a preference to honour — and because
  /// only the first earns an email.
  DISCONNECTED

  @@map("calendar_integration_status")
}

/// What we want the calendar to say about a booking.
enum CalendarEventState {
  PRESENT
  /// Google keeps the event and greys it out. We never DELETE — see the note on
  /// `externalEventId` for why the id has to stay reserved.
  CANCELLED

  @@map("calendar_event_state")
}

enum CalendarSyncStatus {
  PENDING
  SYNCING
  SYNCED
  /// Terminal. The sweep deliberately does not pick these up (tech-impl §26.3
  /// forbids retrying a permanently-broken thing); a human, a reconnect, or
  /// POST /sync resets them.
  FAILED

  @@map("calendar_sync_status")
}

/// One connected Google account. tech-impl §10.14.
model CalendarIntegration {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Whose diary this account fills. Nullable because a tenant-wide connection
  /// is expressible, and `SetNull` rather than `Cascade` because archiving a
  /// provider must not silently destroy a live Google grant — the connection
  /// outlives the assignment, and the mappings below carry the real binding.
  providerId String?   @map("provider_id")
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  /// Who granted consent. They are the only person who can re-consent, which is
  /// why the disconnection email is addressed to them and not to the owner.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerType CalendarProviderType @default(GOOGLE) @map("provider_type")

  /// The Google account's own address, as Google reports it — not the user's
  /// login. A provider may well connect a different account from the one they
  /// sign in with, which is half the reason this is not Better Auth's `accounts`.
  accountEmail String @map("account_email")

  /// Sealed with AES-256-GCM by @bam/crypto (tech-impl §25.2). Never indexed and
  /// never compared: a fresh IV per seal means the same token encrypts
  /// differently every time.
  sealedAccessToken  String? @map("sealed_access_token")
  sealedRefreshToken String? @map("sealed_refresh_token")

  accessTokenExpiresAt DateTime? @map("access_token_expires_at") @db.Timestamptz(3)

  /// What Google actually granted, which may be less than we asked for. Stored
  /// so a missing scope is diagnosable as itself rather than as a 403.
  scopes String[] @default([])

  status    CalendarIntegrationStatus @default(ACTIVE)
  lastError String?                   @map("last_error")

  connectedAt DateTime @default(now()) @map("connected_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  mappings CalendarMapping[]

  /// Reconnecting the same Google account is an upsert rather than a second
  /// row, while a tenant may still connect several different accounts.
  @@unique([tenantId, providerType, accountEmail])
  @@index([tenantId, status])
  @@map("calendar_integrations")
}

/// One selected calendar within a connected account. tech-impl §10.15.
model CalendarMapping {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  calendarIntegrationId String              @map("calendar_integration_id")
  integration           CalendarIntegration @relation(fields: [calendarIntegrationId], references: [id], onDelete: Cascade)

  /// Whose diary this calendar *is*. NOT NULL and `Cascade`: a mapping with no
  /// provider is meaningless, so there is nothing to preserve.
  providerId String   @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  /// Google's calendar id — often an email address, sometimes `primary`.
  externalCalendarId String  @map("external_calendar_id")
  calendarName       String? @map("calendar_name")

  /// The two directions, separately switchable per §10.15. Part 1 only ever
  /// writes, so `readBusy` defaults false and part 2 turns it on rather than
  /// changing a shape.
  readBusy      Boolean @default(false) @map("read_busy")
  writeBookings Boolean @default(true) @map("write_bookings")

  active Boolean @default(true)

  // --- Reserved for part 2 ---------------------------------------------------
  //
  // Declared now and unused, which is what "design the store so a push channel
  // can trigger the same job later" buys. A watch notification will do exactly
  // one thing: enqueue the same sync job a poller would.
  /// Google's incremental-sync cursor.
  syncToken       String?   @map("sync_token")
  watchChannelId  String?   @map("watch_channel_id")
  watchResourceId String?   @map("watch_resource_id")
  watchExpiresAt  DateTime? @map("watch_expires_at") @db.Timestamptz(3)
  lastSyncedAt    DateTime? @map("last_synced_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  eventMappings CalendarEventMapping[]

  /// The same calendar cannot be selected twice within one account.
  @@unique([calendarIntegrationId, externalCalendarId])
  /// One provider, one *writing* calendar — enforced as a partial unique index
  /// in the migration, which Prisma cannot express (record §3.6). One booking,
  /// one event, one answer to "where is this appointment".
  @@index([tenantId, providerId, active])
  @@map("calendar_mappings")
}

/// The mirror of one booking in one calendar. tech-impl §10.16, extended.
///
/// **This model is the phase's centre of gravity — read §2.3 and §2.4 of the
/// record before changing any column here.**
///
/// It separates what we *want* the calendar to say from what it currently says,
/// because a single `syncStatus` cannot express "cancelled, but the cancel has
/// not landed" — it can only say the sync failed, which is a different fact.
model CalendarEventMapping {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  bookingId String  @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  calendarMappingId String          @map("calendar_mapping_id")
  calendarMapping   CalendarMapping @relation(fields: [calendarMappingId], references: [id], onDelete: Cascade)

  /// **Ours, not Google's.** Derived deterministically from
  /// `(bookingId, calendarMappingId)` and supplied to Google on insert, so a
  /// retry landing after the first insert committed is refused with
  /// `409 duplicate` rather than creating a second appointment in somebody's
  /// diary. That is the case the unique index below cannot cover: a worker
  /// killed between Google's 200 and our row update.
  ///
  /// It is also why cancellation is `PATCH status: cancelled` and never
  /// `DELETE` — a deleted id is not immediately reusable, which would break the
  /// guarantee on a booking that is cancelled and then reinstated.
  externalEventId String @map("external_event_id")

  /// Google's version marker. Recorded for part 2's "detect externally modified
  /// events"; deliberately not sent as `If-Match` on our own writes, because we
  /// are the authority and a stale etag would refuse a correction.
  externalEventEtag String? @map("external_event_etag")

  desiredState CalendarEventState @default(PRESENT) @map("desired_state")

  /// `Booking.version` at the moment the desire was recorded. Every booking
  /// write bumps it, so this is what distinguishes reschedule #1 from
  /// reschedule #2 — and what lets the upsert refuse an outbox event that
  /// arrives out of order.
  desiredVersion Int @map("desired_version")

  /// The version Google has. NULL until the first successful write, which is
  /// also how the dispatcher knows to label a job `create-` rather than
  /// `update-booking-event`.
  syncedVersion Int? @map("synced_version")

  syncStatus CalendarSyncStatus @default(PENDING) @map("sync_status")
  attempts   Int                @default(0)

  /// Backoff, the same shape as `outbox_events.available_at`. Without it a
  /// transient 503 spins at the sweep's cadence.
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)

  /// Set while a worker holds the row. A stale value means the worker died, and
  /// the sweep takes it back — the same hole `outbox_events.claimed_at` closes.
  claimedAt    DateTime? @map("claimed_at") @db.Timestamptz(3)
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(3)
  lastError    String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// **The constraint the design rests on.** One event per booking per calendar,
  /// forever. A redelivered outbox event, a reclaimed row and a re-dispatch all
  /// collapse into this one row, and a reschedule updates it rather than
  /// inserting a rival. Same mechanism as `notifications(tenant_id, dedupe_key)`
  /// and enforced the same way: attempt the insert, read a conflict as "already
  /// committed", never SELECT first (rule 14).
  @@unique([bookingId, calendarMappingId])
  /// The reverse lookup part 2 needs: an event id arriving from Google finds its
  /// booking without reading a title, which PRD §9.10 forbids relying on.
  @@unique([calendarMappingId, externalEventId])
  /// The sweep's claim query.
  @@index([syncStatus, nextAttemptAt])
  @@index([tenantId, syncStatus])
  @@map("calendar_event_mappings")
}

/// A pending OAuth handshake. tech-impl §25.1 step 2 requires a state record and
/// never says where it lives (record §3.4).
///
/// A table rather than a signed cookie because **single-use is the property that
/// matters**: a signed value can be replayed until it expires, and a row can be
/// burned. Same reasoning as invitations, and the same storage discipline — only
/// the hash is kept, so a database leak yields nothing replayable.
model CalendarOauthState {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The session that started the flow. The callback refuses a state started by
  /// somebody else, so a stolen link cannot attach a stranger's Google account
  /// to this tenant.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the value in the `state` query parameter. Only the digest is
  /// stored and the row is *found* by it, exactly as an invitation token is —
  /// there is no plaintext here to compare against, which is the point.
  ///
  /// Unique because that is what lets the callback burn it with a single
  /// guarded `updateMany` rather than a read followed by a write (rule 14).
  stateHash String @unique @map("state_hash")

  /// Which diary the resulting calendars will fill. Captured at connect time
  /// because the callback arrives from Google with nothing but the state.
  providerId String? @map("provider_id")

  /// Where to send the browser afterwards. Stored rather than trusted from the
  /// callback's query string, which an attacker controls — an open redirect is
  /// exactly what a callback URL invites.
  returnPath String? @map("return_path")

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// Burned on use. Non-null means this handshake is finished, successfully or
  /// not, and the row survives only as evidence.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// The expiry sweep, and the audit question "who started a connection".
  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("calendar_oauth_states")
}
