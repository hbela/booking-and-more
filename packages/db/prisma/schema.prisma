// Prisma schema for booking-and-more.
//
// Conventions (tech-impl §9):
//   - Every tenant-owned table carries `tenant_id`.
//   - All timestamps are UTC `timestamptz`. Recurring working hours are stored
//     as local wall-clock time and interpreted in the provider's zone — never
//     by adding a UTC offset by hand (tech-impl §13.4).
//   - Money is integer minor units plus a currency code (tech-impl §10.5).
//   - Table and column names are snake_case via @map/@@map; the TS API stays
//     camelCase.
//
// Phase 0 defined `Tenant`. Phase 1 (Epic 1) added identity and tenancy: the
// Better Auth tables, plus Membership, Invitation and AuditLog. Phase 2
// (Epic 2) added the catalogue a tenant configures before it can take a
// booking: Provider, Service, Location and the two join tables that connect
// them. Phase 3 (Epic 3) added WorkingHours and AvailabilityException, which is
// what the availability engine reads. Phase 4 (Epic 4) adds the booking itself:
// Customer, CapacityReservation, BookingHold, Booking, OutboxEvent and
// IdempotencyKey.
//
// Identity vs. authorization: Better Auth owns User/Session/Account/
// Verification and nothing else. Roles live on Membership — never on User — so
// there is exactly one answer to "what may this person do here".
// See packages/auth/src/roles.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 removed `url` from the datasource block. The connection URL used by
// the CLI (migrate, studio, db pull) now lives in prisma.config.ts; the runtime
// client gets its connection from a driver adapter — see src/index.ts.
datasource db {
  provider = "postgresql"
}

/// Lifecycle of a tenant. Gates every write: a suspended tenant accepts no new
/// bookings (Epic 9 exit criterion). tech-impl §10.1.
enum TenantStatus {
  /// Reserved for a real free-trial offering. No flow reaches it yet, and it is
  /// deliberately *not* reused for PENDING_SUBSCRIPTION: a trial is the product
  /// working for free, which that is not.
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
  /// Provisioned by a platform admin, owner can sign in, nothing configurable
  /// until a subscription arrives. See docs/phase-9-saas-administration.md §2.1.
  ///
  /// Listed last rather than first on purpose: PostgreSQL can only append to an
  /// enum in place, so inserting a value mid-list makes Prisma recreate the type
  /// — a destructive migration requiring an interactive prompt, for the sake of
  /// alphabetical tidiness nobody reads.
  PENDING_SUBSCRIPTION

  @@map("tenant_status")
}

/// A business using the platform. The root of every ownership chain.
model Tenant {
  id String @id @default(cuid(2))

  /// URL segment: booking.example.com/<slug>. Immutable once published.
  slug String @unique @db.Citext
  name String

  /// The business's own domain, e.g. `wellness.hu`. The identity of the
  /// organization (phase-9 §2.3) — distinct from `slug`, which is a URL segment
  /// we choose. Unique so a prospect worked by two salespeople becomes one
  /// organization and a constraint violation, rather than two half-configured
  /// tenants nobody notices until billing.
  ///
  /// Nullable only because tenants predating Epic 9 have none; provisioning
  /// requires it. Stored normalized (lower-cased, no scheme, no `www.`) by
  /// `normalizeDomain` in @bam/contracts — a raw value would make the constraint
  /// decorative, since `WWW.Wellness.HU` and `wellness.hu` are one business.
  domain String? @unique @db.Citext

  status TenantStatus @default(TRIAL)

  /// Deadline for the first subscription, set when a prospect organization is
  /// provisioned and cleared when it subscribes. NULL means no deadline: an
  /// internal or demo organization, which never expires (phase-9 §2.2).
  subscribeBy DateTime? @map("subscribe_by") @db.Timestamptz(3)

  /// IANA zone, e.g. "Europe/Budapest". Validated in application code — Postgres
  /// will accept any string here.
  defaultTimezone String @default("Europe/Budapest") @map("default_timezone")
  /// BCP-47 subtag. Hungarian and English at launch (PRD §12.5).
  defaultLanguage String @default("hu") @map("default_language")

  // --- Branding (Epic 9: white-label) ---------------------------------------
  logoUrl      String? @map("logo_url")
  primaryColor String? @map("primary_color")

  // --- Contact --------------------------------------------------------------
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  // --- Policies surfaced during booking (PRD §9.1) --------------------------
  bookingPolicy      String? @map("booking_policy")
  cancellationPolicy String? @map("cancellation_policy")
  privacyPolicyUrl   String? @map("privacy_policy_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  sessions    Session[]

  providers              Provider[]
  services               Service[]
  locations              Location[]
  providerServices       ProviderService[]
  providerLocations      ProviderLocation[]
  workingHours           WorkingHours[]
  availabilityExceptions AvailabilityException[]

  customers            Customer[]
  capacityReservations CapacityReservation[]
  bookingHolds         BookingHold[]
  bookings             Booking[]
  outboxEvents         OutboxEvent[]
  idempotencyKeys      IdempotencyKey[]
  notifications        Notification[]
  subscription         Subscription?
  checkoutLink         SubscriptionCheckoutLink?

  @@index([status])
  /// The expiry sweep's query: prospect organizations past their deadline.
  @@index([status, subscribeBy])
  @@map("tenants")
}

// ===========================================================================
// Identity — owned by Better Auth
//
// These four models mirror Better Auth's core schema. The field names are
// dictated by the adapter, so they stay camelCase in the database (no @map) to
// keep that mapping trivial and avoid a class of "worked until you added a
// plugin" bugs. Only `isPlatformAdmin` is ours, declared through
// additionalFields in packages/auth/src/auth.ts.
// ===========================================================================

model User {
  id            String  @id @default(cuid(2))
  name          String
  email         String  @unique @db.Citext
  emailVerified Boolean @default(false)
  image         String?

  /// Platform operator. Deliberately NOT a tenant role (see roles.ts): running
  /// the platform is not scoped to a tenant. Better Auth declares this field
  /// with `input: false`, so no sign-up or update request can set it — only a
  /// deliberate server-side script can.
  isPlatformAdmin Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  invitesSent Invitation[] @relation("InvitationInviter")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid(2))
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Last tenant the user was working in. A UI convenience only — never trusted
  /// for authorization. Every request re-resolves membership server-side
  /// (tech-impl §7.2).
  activeTenantId String?
  activeTenant   Tenant? @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  /// Hashed by Better Auth. Never logged — see @bam/observability redaction.
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// ===========================================================================
// Tenancy — ours
// ===========================================================================

/// tech-impl §8.3. PLATFORM_ADMIN is absent on purpose: it is a user flag, not
/// a tenant role, so it cannot be granted through an invitation.
enum MembershipRole {
  OWNER
  ADMIN
  PROVIDER
  ASSISTANT
  CUSTOMER

  @@map("membership_role")
}

/// A membership grants nothing unless ACTIVE.
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

/// The (tenant, user) pair that carries a role. tech-impl §10.3.
model Membership {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   MembershipRole
  status MembershipStatus @default(ACTIVE)

  /// Links a PROVIDER membership to its schedule — the thing the `:own`
  /// permissions in policy.ts match against.
  ///
  /// Nullable in both directions on purpose: a provider need not have a login
  /// (a visiting hygienist whose diary the front desk keeps), and a member need
  /// not be a provider. `SetNull` rather than `Cascade` because archiving a
  /// provider must not delete the person's membership and with it their access.
  providerId String?   @map("provider_id")
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  invitedByUserId String?   @map("invited_by_user_id")
  joinedAt        DateTime? @map("joined_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// One membership per person per tenant (tech-impl §10.3).
  @@unique([tenantId, userId])
  /// And at most one login per provider diary. Postgres treats NULLs as
  /// distinct, so this constrains only the rows that actually name a provider.
  /// Without it, two accounts could both hold `:own` permissions over the same
  /// schedule and neither would know about the other.
  @@unique([providerId])
  @@index([tenantId, status])
  @@index([userId])
  @@index([providerId])
  @@map("memberships")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

/// A pending invitation to join a tenant with a given role.
///
/// Only the SHA-256 hash of the token is stored, exactly as for booking
/// management tokens (tech-impl §34.4): a database leak must not hand the
/// attacker usable invitation links.
model Invitation {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email String         @db.Citext
  role  MembershipRole

  /// The diary this invitation links its membership to, on acceptance.
  ///
  /// Nullable because most invitations name a role and nothing else. When it is
  /// set, `claimInvitation` writes `Membership.providerId` in the *same*
  /// transaction that burns the token — the two-screen dance (invite, then
  /// PATCH the membership) is what this column exists to delete.
  ///
  /// `Cascade`, deliberately the opposite of the `SetNull` on Membership above.
  /// A membership that loses its provider still carries a person's access, so
  /// nulling is the conservative act there. An invitation that loses its
  /// provider is a promise nobody can keep: silently downgrading it to a bare
  /// PROVIDER invitation would grant a role over no diary and tell nobody.
  /// `Restrict` would be worse than either — it would make the tenant-delete
  /// cascade fail, breaking `db:discard-organization`.
  /// docs/phase-9-provider-onboarding.md §2.2.
  providerId String?   @map("provider_id")
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  tokenHash String           @unique @map("token_hash")
  status    InvitationStatus @default(PENDING)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)

  invitedByUserId String @map("invited_by_user_id")
  invitedBy       User   @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// At most one live invitation per email per tenant is enforced as a partial
  /// unique index in a follow-up custom migration — Prisma cannot express
  /// `WHERE status = 'PENDING'`, and a plain unique index would stop a revoked
  /// invitation from ever being reissued.
  ///
  /// A second such index, added later, does the same for `provider_id`: at most
  /// one live invitation per diary (phase-9-provider-onboarding §2.3).
  @@index([tenantId, status])
  @@index([email])
  @@index([providerId])
  @@map("invitations")
}

/// Who performed an audited action. tech-impl §10.20.
enum AuditActorType {
  USER
  PLATFORM_ADMIN
  SYSTEM
  CUSTOMER

  @@map("audit_actor_type")
}

/// Append-only audit trail. tech-impl §10.20, §34.5.
///
/// There is no update or delete path in application code, and the model has no
/// `updatedAt` — an audit row that can be edited is not an audit row.
model AuditLog {
  id String @id @default(cuid(2))

  /// Nullable: platform-level actions such as creating a tenant have no tenant
  /// to attribute to yet.
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actorType AuditActorType @map("actor_type")
  actorId   String?        @map("actor_id")

  /// Past-tense verb, e.g. "tenant.created", "membership.role_changed".
  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")

  /// Snapshots for diffing. Must never contain credentials or customer PII.
  beforeJson Json? @map("before_json")
  afterJson  Json? @map("after_json")

  requestId String? @map("request_id")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ===========================================================================
// Catalogue — Epic 2
//
// What a tenant configures before it can take a booking: who does the work
// (Provider), what the work is (Service), where it happens (Location), and
// which combinations are allowed (ProviderService, ProviderLocation).
//
// ## Two flags, not one
//
// Every catalogue row has both `active` and `archivedAt`, and they mean
// different things:
//
//   active     — temporarily off. A provider on parental leave, a service only
//                offered in summer. Flipped back on routinely.
//   archivedAt — removed. Hidden from every list and every picker, kept only so
//                that a booking made last March still knows what it was for.
//
// Nothing in the catalogue is ever hard-deleted through the API. The
// predecessor project deleted services outright and left bookings pointing at a
// row that no longer existed; every screen that joined through it then had to
// cope with a null it was never designed for.
//
// ## Inheritance of booking-window fields
//
// `minimumNoticeMinutes` and `maximumAdvanceDays` appear on both Provider and
// Service, and are nullable on both. NULL means "inherit", and the availability
// engine resolves the pair in Epic 3 by taking the *most restrictive* value
// that applies (tech-impl §13.3). A zero is therefore meaningfully different
// from a NULL, which is why neither has a database default.
// ===========================================================================

/// tech-impl §10.7. ONLINE and TELEPHONE locations have no address; the API
/// enforces that, since Postgres cannot express "address required unless type
/// is ONLINE" without a check constraint per column.
enum LocationType {
  PHYSICAL
  ONLINE
  HOME_VISIT
  TELEPHONE

  @@map("location_type")
}

/// Someone (or something) that appointments are booked with. tech-impl §10.4.
///
/// Deliberately not the same thing as a user: a provider is a bookable
/// resource. Linking one to a login is what `Membership.providerId` is for.
model Provider {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Shown to customers, so it is whatever the clinic calls this person —
  /// "Dr. Kovács Anna", not a normalised first/last name pair we would then
  /// have to reassemble differently per locale (tech-impl §38).
  displayName String  @map("display_name")
  description String?

  email String?
  phone String?

  /// Resolved from the tenant default at creation rather than left NULL: the
  /// availability engine reads this on every slot calculation, and a nullable
  /// zone there is a null check in the middle of DST arithmetic (tech-impl
  /// §13.4).
  timezone String

  /// BCP-47 subtags this provider can work in. A text array rather than a join
  /// table — it is read on every public provider list and never queried the
  /// other way round.
  languages String[] @default([])

  active               Boolean @default(true)
  /// Off means staff can still book this provider, but the public booking page
  /// will not offer them (PRD §9.4).
  onlineBookingEnabled Boolean @default(true) @map("online_booking_enabled")

  /// NULL means inherit — see the section comment above.
  minimumNoticeMinutes Int? @map("minimum_notice_minutes")
  maximumAdvanceDays   Int? @map("maximum_advance_days")

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  invitations Invitation[]
  services    ProviderService[]
  locations   ProviderLocation[]

  workingHours           WorkingHours[]
  availabilityExceptions AvailabilityException[]

  capacityReservations CapacityReservation[]
  bookingHolds         BookingHold[]
  bookings             Booking[]

  @@index([tenantId, active])
  @@map("providers")
}

/// A bookable unit of work. tech-impl §10.5.
model Service {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Name in the tenant's default language. Other locales live in
  /// ServiceTranslation (tech-impl §38).
  name        String
  /// Appears in the public booking URL, so it is unique per tenant and not
  /// editable once customers may have linked to it.
  slug        String
  description String?

  durationMinutes     Int @map("duration_minutes")
  /// Padding around the appointment that blocks the diary without being shown
  /// to the customer — room turnaround, notes, travel (tech-impl §13.3).
  bufferBeforeMinutes Int @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int @default(0) @map("buffer_after_minutes")

  /// Integer minor units (tech-impl §10.5): $125.00 is 12500. NULL means the
  /// price is not published — "on consultation" — which is different from free.
  priceMinor Int?    @map("price_minor")
  currency   String? @db.Char(3)

  active           Boolean @default(true)
  /// The booking is requested rather than confirmed; staff accept it. Honoured
  /// by the booking engine in Epic 4.
  requiresApproval Boolean @default(false) @map("requires_approval")

  /// NULL means inherit — see the section comment above.
  minimumNoticeMinutes Int? @map("minimum_notice_minutes")
  maximumAdvanceDays   Int? @map("maximum_advance_days")

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations           ServiceTranslation[]
  providers              ProviderService[]
  availabilityExceptions AvailabilityException[]

  bookingHolds BookingHold[]
  bookings     Booking[]

  @@unique([tenantId, slug])
  @@index([tenantId, active])
  @@map("services")
}

/// Tenant-managed translations of a service. tech-impl §38.
///
/// Only user-facing text is translated; the slug, duration and price stay
/// language-neutral, so there is exactly one bookable thing however many
/// languages describe it.
model ServiceTranslation {
  id String @id @default(cuid(2))

  serviceId String  @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// BCP-47 subtag. Validated against the supported set in application code.
  locale String

  name        String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([serviceId, locale])
  @@map("service_translations")
}

/// Where an appointment happens. tech-impl §10.7.
model Location {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  type LocationType @default(PHYSICAL)

  addressLine1 String? @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String?
  postalCode   String? @map("postal_code")
  /// ISO 3166-1 alpha-2, upper case.
  countryCode  String? @map("country_code") @db.Char(2)

  /// A location can sit in a different zone from its tenant — a chain with a
  /// branch across a border. Slots are computed in the location's zone when one
  /// is set (tech-impl §13.4).
  timezone String

  /// Double precision is ample for a map pin; nothing here does geometry, so
  /// PostGIS would be a dependency bought for nothing.
  latitude  Float?
  longitude Float?

  active Boolean @default(true)

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  providers              ProviderLocation[]
  workingHours           WorkingHours[]
  availabilityExceptions AvailabilityException[]

  bookingHolds BookingHold[]
  bookings     Booking[]

  @@index([tenantId, active])
  @@map("locations")
}

/// Which providers offer which services, and on what terms. tech-impl §10.6.
///
/// `tenantId` is denormalised onto the join row so every query can be scoped by
/// tenant in one predicate rather than through two joins. Keeping it consistent
/// with the parents is the service layer's job: both sides are loaded
/// tenant-scoped before the link is written, so a cross-tenant assignment reads
/// as a 404 on the entity that "does not exist" for this caller.
model ProviderService {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  providerId String   @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  serviceId String  @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// Per-provider overrides. NULL means "use the service's own value" — a
  /// senior dentist may take longer, or charge more, for the same procedure.
  customDurationMinutes Int? @map("custom_duration_minutes")
  customPriceMinor      Int? @map("custom_price_minor")

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, serviceId])
  @@index([tenantId, serviceId])
  @@map("provider_services")
}

/// Where a provider works. tech-impl §10.8.
model ProviderLocation {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  providerId String   @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, locationId])
  @@index([tenantId, locationId])
  @@map("provider_locations")
}

// ===========================================================================
// Availability — Epic 3
//
// What the availability engine reads. The engine itself is a pure package
// (@bam/availability-engine, tech-impl §13) and knows nothing about these
// tables; the API loads them and hands over plain values.
//
// ## Wall-clock, not instants
//
// `WorkingHours.startTime` and `endTime` are local `HH:mm` strings, never
// timestamps (tech-impl §13.4). "Mondays 09:00–17:00" must stay 09:00–17:00 on
// the Monday the clocks change, and a stored UTC offset cannot express that —
// it is right for half the year and an hour wrong for the other half.
//
// `AvailabilityException`, by contrast, names actual moments ("closed on the
// 24th from 12:00"), so it stores timestamptz. The difference is the point: one
// is a rule, the other is an event.
// ===========================================================================

/// tech-impl §10.10.
enum ExceptionType {
  /// Time removed from the schedule — a holiday, sick leave, a meeting.
  UNAVAILABLE
  /// Time added outside the recurring hours — a one-off Saturday clinic.
  ADDITIONAL_AVAILABILITY

  @@map("exception_type")
}

/// Where an exception came from. Voice and chat land here from Epics 7–8, so
/// "who blocked this out" stays answerable after the fact (tech-impl §10.10).
enum ExceptionSource {
  DASHBOARD
  VOICE
  CHAT
  CALENDAR
  API

  @@map("exception_source")
}

/// A recurring weekly working period. tech-impl §10.9.
///
/// Multiple rows per weekday are expected and are how a lunch break is
/// expressed: Monday 09:00–12:00 and Monday 13:00–17:00 is a schedule with a
/// gap, not a schedule with an attribute.
model WorkingHours {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  providerId String   @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  /// Null means "wherever this provider works". Set it when a provider keeps
  /// different hours at different sites.
  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  /// ISO 8601: Monday = 1 … Sunday = 7.
  weekday Int

  /// Local `HH:mm`. `24:00` is permitted as an end, meaning midnight; the
  /// format is enforced by a CHECK constraint in the migration, because a
  /// malformed time here would fail deep inside a slot calculation.
  startTime String @map("start_time") @db.VarChar(5)
  endTime   String @map("end_time") @db.VarChar(5)

  /// Optional validity window, for a schedule that changes on a known date.
  /// Dates rather than timestamps: "from the first of March" is a calendar
  /// fact, not an instant.
  validFrom  DateTime? @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, providerId, weekday])
  @@index([locationId])
  @@map("working_hours")
}

/// A one-off change to a provider's availability. tech-impl §10.10.
model AvailabilityException {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  providerId String   @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  /// Both optional: an exception can be narrowed to one site or one service,
  /// or apply to everything the provider does.
  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  serviceId String?  @map("service_id")
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  type ExceptionType @map("exception_type")

  /// Absolute instants — this is an event, not a rule. A CHECK constraint in
  /// the migration enforces that it ends after it starts.
  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt   DateTime @map("end_at") @db.Timestamptz(3)

  /// Shown to staff, never to customers: "dentist appointment" is nobody
  /// else's business.
  reason String?

  source ExceptionSource @default(DASHBOARD)

  /// Null when the platform created it — a calendar sync, for instance.
  createdByUserId String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The shape of every availability query: this provider, overlapping this
  /// window.
  @@index([tenantId, providerId, startAt, endAt])
  @@index([locationId])
  @@index([serviceId])
  @@map("availability_exceptions")
}

// ===========================================================================
// Bookings — Epic 4
//
// tech-impl §10.11-10.13, §11, §12, §32.
//
// ## The three tables that look like one thing
//
// A slot being taken is recorded in up to three rows, and the separation is
// deliberate:
//
//   capacity_reservations  *the* gate. One exclusion constraint over this table
//                          stops two people occupying one provider at one time,
//                          whether they are holding or booked (§11.3).
//   booking_holds          a customer's five minutes to fill in a form.
//   bookings               the appointment itself.
//
// A hold owns a reservation; on confirmation the booking *adopts* that same
// reservation row rather than swapping it, so the slot is never unguarded for
// even an instant of the transaction (§11.5 step 6).
//
// ## Spans: appointment versus occupied
//
// `booking_holds` and `bookings` store the appointment — what the customer was
// told, what a confirmation email says. `capacity_reservations` stores the
// occupied window, buffers included, which is what the diary actually loses and
// what the next availability search subtracts. Both come from
// @bam/booking-engine's `occupiedSpanFor`, which is the only definition of
// either.
// ===========================================================================

/// PRD §9.9.
enum BookingStatus {
  /// Awaiting staff acceptance — `Service.requiresApproval`. Still blocks the
  /// slot: the customer asked first, and a slow decision must not cost them it.
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  /// Nobody acted on a PENDING booking before its start time passed.
  EXPIRED

  @@map("booking_status")
}

/// tech-impl §10.13. Where a booking came from.
enum BookingSource {
  FORM
  CHAT
  VOICE
  STAFF
  API

  @@map("booking_source")
}

/// tech-impl §10.12.
enum HoldStatus {
  ACTIVE
  /// Became a booking.
  CONFIRMED
  /// Given up deliberately — the customer went back a step.
  RELEASED
  /// Ran out of time. Written lazily; see `expiresAt` below.
  EXPIRED

  @@map("hold_status")
}

/// tech-impl §11.3. Two values, because a reservation either blocks or it does
/// not — a confirmed booking's reservation stays ACTIVE, since it is still
/// occupying the diary.
enum ReservationStatus {
  ACTIVE
  RELEASED

  @@map("reservation_status")
}

/// tech-impl §12.
enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@map("outbox_status")
}

/// Someone who books. tech-impl §10.11.
///
/// Not a User: a customer never signs in during the MVP, and conflating the two
/// would put booking history behind an account nobody has. A customer belongs to
/// one tenant — the same person booking at two clinics is two rows, because the
/// clinics may not see each other's records.
model Customer {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The tenant's own identifier for this person — a patient number carried in
  /// from whatever they used before.
  externalReference String? @map("external_reference")

  fullName String  @map("full_name")
  email    String?
  phone    String?

  /// Matching keys, maintained by the API through @bam/booking-engine's
  /// normalizers (tech-impl §10.11). Stored rather than computed so the lookup
  /// is an index scan; separate from the display columns because `email` is what
  /// the customer typed and should be what a confirmation is addressed to.
  ///
  /// Records are never merged on name alone — two people called Nagy Péter is a
  /// Tuesday in Hungary, and merging them is a data-protection incident.
  normalizedEmail String? @map("normalized_email")
  normalizedPhone String? @map("normalized_phone")

  preferredLanguage String  @default("hu") @map("preferred_language")
  timezone          String?

  marketingConsent Boolean @default(false) @map("marketing_consent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  holds         BookingHold[]
  bookings      Booking[]
  notifications Notification[]

  @@index([tenantId, normalizedEmail])
  @@index([tenantId, normalizedPhone])
  @@map("customers")
}

/// The exclusive-capacity gate. tech-impl §11.3.
///
/// Every row here is a claim on one provider's time. The exclusion constraint —
/// hand-written, because Prisma cannot express it — refuses a second ACTIVE row
/// overlapping an existing one for the same provider. That single constraint is
/// what makes "two concurrent users cannot confirm the same slot" true, and it
/// is true because PostgreSQL enforces it, not because application code checked
/// first and hoped.
///
/// `startAt`/`endAt` are the **occupied** span: buffers included.
model CapacityReservation {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  providerId String   @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  /// Who owns the claim: the booking if there is one, otherwise the hold.
  ///
  /// Confirmation sets `bookingId` and leaves `holdId` in place, so ownership
  /// moves within one transaction without the row ever ceasing to be ACTIVE —
  /// the slot is never unguarded — and the booking's lineage back to the hold
  /// that produced it stays readable. A CHECK constraint in the migration
  /// requires an ACTIVE row to have at least one of the two: an ownerless
  /// reservation is unreachable and would block its slot forever.
  holdId String?      @unique @map("hold_id")
  hold   BookingHold? @relation(fields: [holdId], references: [id], onDelete: SetNull)

  bookingId String?  @unique @map("booking_id")
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt   DateTime @map("end_at") @db.Timestamptz(3)

  status ReservationStatus @default(ACTIVE)

  /// Set while a hold owns the row, NULL once a booking does — a booking does
  /// not time out.
  ///
  /// An exclusion constraint's predicate cannot call `now()`, so an expired
  /// reservation goes on blocking its slot until something rewrites its status.
  /// Until Epic 5 brings a worker, the API sweeps these inside the transaction
  /// that creates the next hold, which is the one moment the answer matters.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, providerId, startAt, endAt])
  /// Drives the expiry sweep.
  @@index([status, expiresAt])
  @@map("capacity_reservations")
}

/// A customer's few minutes to finish the form. tech-impl §10.12, PRD §9.8.
///
/// `startAt`/`endAt` are the appointment, not the diary block — the block lives
/// on the reservation this hold owns.
model BookingHold {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  providerId String   @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  serviceId String  @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  /// Set only if the customer is already known — a hold is created before any
  /// details are collected.
  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Opaque client-supplied string tying a hold to one browser tab or one
  /// conversation. Not a login and not trusted for authorization; it exists so a
  /// customer can be shown the hold they made rather than somebody else's.
  sessionId String @map("session_id")

  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt   DateTime @map("end_at") @db.Timestamptz(3)

  status HoldStatus @default(ACTIVE)

  /// The truth about whether this hold is live. `status` is a cache of it,
  /// written when something happens to notice — see @bam/booking-engine's
  /// `effectiveHoldStatus`.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reservation CapacityReservation?
  bookings    Booking[]

  @@index([tenantId, providerId, startAt])
  @@index([tenantId, sessionId])
  @@index([status, expiresAt])
  @@map("booking_holds")
}

/// An appointment. tech-impl §10.13.
model Booking {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Short, human-readable, unique within the tenant. What a customer reads out
  /// on the phone, and what a confirmation email leads with.
  reference String

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])

  providerId String   @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id])

  serviceId String  @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id])

  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  /// The hold this came from, kept for the audit trail. NULL for a staff booking
  /// made straight from the diary, which never needed one.
  holdId String?      @map("hold_id")
  hold   BookingHold? @relation(fields: [holdId], references: [id], onDelete: SetNull)

  /// The appointment. The diary block, buffers included, is on the reservation.
  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt   DateTime @map("end_at") @db.Timestamptz(3)

  status BookingStatus @default(CONFIRMED)
  source BookingSource @default(FORM)

  // --- Snapshots ------------------------------------------------------------
  //
  // Catalogue rows are archived rather than deleted (CLAUDE.md rule 11), so the
  // foreign keys above never dangle. That solves referential integrity and
  // nothing else: a service renamed and repriced next year would make this
  // booking claim the customer agreed to a price they never saw. These columns
  // record what they were actually told.
  customerNameSnapshot  String  @map("customer_name_snapshot")
  customerEmailSnapshot String? @map("customer_email_snapshot")
  customerPhoneSnapshot String? @map("customer_phone_snapshot")
  serviceNameSnapshot   String  @map("service_name_snapshot")
  priceMinorSnapshot    Int?    @map("price_minor_snapshot")
  currencySnapshot      String? @map("currency_snapshot") @db.Char(3)

  notes String?

  cancellationReason String?   @map("cancellation_reason")
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// NULL when a customer booked themselves.
  createdByUserId String? @map("created_by_user_id")

  /// SHA-256 of the token in the customer's management URL (tech-impl §34.4).
  /// The raw token is shown once and never stored, exactly as for invitations.
  managementTokenHash String? @unique @map("management_token_hash")

  /// Optimistic-locking counter, bumped on every write.
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reservation   CapacityReservation?
  notifications Notification[]

  @@unique([tenantId, reference])
  @@index([tenantId, providerId, startAt])
  @@index([tenantId, status, startAt])
  @@index([tenantId, customerId])
  @@map("bookings")
}

/// tech-impl §12.
///
/// A queue job published inside a transaction is lost if the transaction rolls
/// back, and a transaction that waits on a queue fails when the queue is down.
/// So nothing publishes: the confirming transaction writes a row here, and the
/// worker turns rows into BullMQ jobs once it exists (Epic 5). Until then these
/// accumulate, which is the correct behaviour — the events are the record that
/// something needs sending, and nothing about them expires.
model OutboxEvent {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// BOOKING_CONFIRMED, BOOKING_CANCELLED, … Deliberately a string rather than
  /// an enum: adding an event type should not need a migration, and the worker
  /// ignores what it does not recognise.
  eventType String @map("event_type")

  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id")

  payload Json @map("payload_json")

  status OutboxStatus @default(PENDING)

  /// Lets an event be scheduled rather than sent at once — a reminder the day
  /// before, for instance.
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  attempts    Int      @default(0)
  lastError   String?  @map("last_error")

  /// When a dispatcher took this row. Without it, a worker killed mid-batch
  /// leaves rows PROCESSING forever: nothing distinguishes "being worked on
  /// right now" from "claimed by a process that no longer exists". The claim
  /// query treats a stale timestamp as abandoned and takes the row back.
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  /// The worker's claim query: everything due and unsent, oldest first.
  @@index([status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH

  @@map("notification_channel")
}

/// What happened, not which template rendered it. A tenant that later wants a
/// different confirmation wording changes `template`; this stays the same, so
/// "how many confirmations did we send" survives a copy rewrite.
enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_UPDATED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  CALENDAR_DISCONNECTED
  /// Sent to a newly provisioned organization's owner, carrying their
  /// single-use acceptance link (phase-9 §2.5). Appended rather than inserted:
  /// PostgreSQL can only add enum values at the end without recreating the type.
  ORGANIZATION_CREATED
  /// The owner's Stripe payment link, emailed so it can be forwarded to
  /// whoever holds the company card (phase-9-subscription-and-activation.md
  /// §1.1). Appended, for the same reason as the value above.
  SUBSCRIPTION_LINK
  /// Three days before a free trial converts to a paid subscription
  /// (phase-9-subscription-lifecycle.md §2.1). The card is already on file, so
  /// this is a courtesy — and a charge nobody expected is the commonest reason
  /// a new customer disputes one. Appended, as above.
  TRIAL_ENDING_SOON
  /// A renewal was declined. Access continues while Stripe retries, so this
  /// exists to get the card fixed before dunning runs out and the organization
  /// is suspended (§2.3). Appended, as above.
  SUBSCRIPTION_PAYMENT_FAILED
  /// The subscription went live — the receipt for the whole onboarding path.
  ///
  /// Sent once per Stripe subscription, ever, which is why its dedupe key is
  /// the subscription id rather than the outbox event: `customer.subscription.*`
  /// fires on every later change and each one would otherwise earn an email.
  ///
  /// It closes the loop the payment link opened. Until this existed the owner
  /// paid on Stripe's page and heard nothing from us again — the one moment in
  /// onboarding where silence reads as failure, because they have just been
  /// charged. Appended, as above.
  SUBSCRIPTION_CONFIRMED

  /// A provider invited to set up their own login, carrying the single-use link
  /// that also links their membership to their diary
  /// (phase-9-provider-onboarding §2.8). Appended, as above.
  PROVIDER_INVITED

  @@map("notification_type")
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  /// Deliberately not FAILED. A booking taken over the phone with no email
  /// address has nothing to send to, and that is a correct outcome — treating
  /// it as a failure would fill a dead-letter queue with bookings that are fine.
  SKIPPED

  @@map("notification_status")
}

/// tech-impl §27.
///
/// One row per message the platform owes someone, written before anything is
/// sent and updated as delivery progresses. It is the delivery-tracking record
/// and the deduplication key at once.
///
/// Epic 5's exit criterion is that duplicate events do not send duplicate
/// messages, and `dedupeKey` is how that is enforced: the unique index refuses
/// the second row, so a redelivered outbox event, a retried job and a
/// double-clicked confirmation all collapse to one email. Application code
/// translates the unique violation into "already handled" — it does not SELECT
/// first and hope, for the same reason capacity reservations do not
/// (CLAUDE.md rule 14).
model Notification {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Nullable because not every notification is about a booking — a calendar
  /// disconnection is addressed to staff.
  bookingId String?  @map("booking_id")
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  type    NotificationType
  channel NotificationChannel @default(EMAIL)

  /// The address as it was at send time. Snapshotted for the same reason the
  /// booking snapshots its price (rule 15): "where did we actually send this"
  /// must survive the customer later changing their email.
  recipient String

  /// Template identifier, e.g. `booking-confirmation`. Resolved by
  /// @bam/notification-engine; a string rather than an enum so adding a
  /// template is not a migration.
  template String
  /// BCP-47, resolved from the customer then the tenant.
  locale String

  status NotificationStatus @default(PENDING)

  /// The provider's id for this message, kept so a delivery webhook or a
  /// support question can be traced back to a row.
  providerMessageId String? @map("provider_message_id")

  attempts  Int     @default(0)
  lastError String? @map("last_error")

  /// When it should go out. Now for a confirmation, hours ahead for a reminder.
  scheduledAt DateTime  @map("scheduled_at") @db.Timestamptz(3)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(3)

  /// Stable identity of "this message, for this thing, once" — built by
  /// @bam/notification-engine so the rule lives in one testable place.
  dedupeKey String @map("dedupe_key")

  /// Values the template needs that cannot be re-derived at send time.
  ///
  /// Almost every notification re-reads its subject from the database when the
  /// job runs, which is why a confirmation reflects the booking as it is now.
  /// A provisioning email cannot: it carries a single-use invitation link, and
  /// the invitation stores only a SHA-256 hash (tech-impl §34.4), so the raw
  /// token exists nowhere else. It is held here and cleared on successful
  /// send, which bounds the exposure to the seconds a queued job waits.
  payload Json? @map("payload_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The exit criterion, as a constraint.
  @@unique([tenantId, dedupeKey])
  /// The sender's claim query: everything due and unsent.
  @@index([status, scheduledAt])
  @@index([tenantId, bookingId])
  @@map("notifications")
}

/// tech-impl §32.
///
/// A customer on a hotel wifi taps "Confirm", the response is lost, and the
/// retry must return the first booking rather than make a second one. The key
/// is the client's; `requestHash` is ours, so that reusing a key with a
/// different payload is refused rather than silently answered with the wrong
/// booking.
model IdempotencyKey {
  id String @id @default(cuid(2))

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key       String
  /// The route this key was used for. Scoped so that one client-generated key
  /// reused across two different operations does not collide.
  operation String

  requestHash String @map("request_hash")

  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ===========================================================================
// Billing — docs/phase-9-saas-administration.md
// ===========================================================================

enum SubscriptionPlan {
  /// Not sold. Demo and internal organizations carry this so that "which plan
  /// is this tenant on" never returns nothing, and so quota enforcement has
  /// something to read (phase-9 §2.2).
  INTERNAL
  STARTER
  PROFESSIONAL

  @@map("subscription_plan")
}

/// Mirrors Stripe's subscription statuses. A string enum rather than free text
/// so an unrecognised value from a webhook is a loud failure, not a silent one.
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
  /// INTERNAL plans, which have no Stripe counterpart to be a status of.
  NOT_APPLICABLE

  @@map("subscription_status")
}

/// What the tenant is paying for. phase-9 §2.7.
///
/// Stripe is the source of truth for money; this mirrors only what the
/// application acts on — whether writes are allowed, which plan's quotas apply,
/// and enough identifiers to deep-link into Stripe from the admin dashboard.
/// Anything else is read from Stripe on demand rather than synchronised.
model Subscription {
  id String @id @default(cuid(2))

  /// One per tenant. The unique constraint is load-bearing: it is what stops a
  /// redelivered Stripe webhook creating a second subscription for one payment
  /// (CLAUDE.md rule 14 — the database decides, application code translates).
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan
  status SubscriptionStatus @default(NOT_APPLICABLE)

  /// Nullable so an INTERNAL subscription can exist with no Stripe counterpart.
  /// PostgreSQL allows repeated NULLs under a unique index, so this still
  /// refuses two tenants claiming one real Stripe subscription.
  stripeCustomerId     String? @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")

  /// What was actually bought. The plan is resolved *from* this, mapped through
  /// STRIPE_PRICE_* config (phase-9-subscription-lifecycle.md §2.4); stored so a
  /// wrong plan is diagnosable without opening Stripe.
  stripePriceId String? @map("stripe_price_id")

  currentPeriodEnd  DateTime? @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")

  // --- Trial (phase-9-subscription-lifecycle.md §2.1, §5) -------------------

  /// When the free trial ends. Stripe's `trial_end`, mirrored — the screen
  /// counts down to this rather than to TRIAL_PERIOD_DAYS, which is only copy.
  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz(3)

  /// Set the first time this organization starts a trial, and never overwritten.
  ///
  /// It lives here rather than on Tenant because this row survives cancellation
  /// — `customer.subscription.deleted` sets the status to CANCELED and keeps it
  /// — which is exactly the case it answers: an owner who cancels and
  /// resubscribes must not receive another thirty free days. `requestPaymentLink`
  /// reads it to choose between the trial and no-trial Payment Link.
  trialUsedAt DateTime? @map("trial_used_at") @db.Timestamptz(3)

  // --- Scheduled plan change (§2.4, guide §4) -------------------------------
  //
  // A downgrade does not change the subscription; Stripe attaches a *schedule*
  // whose next phase carries the new price. Mirrored so the screen can say
  // "Professional until 18 September, then Starter" rather than showing a plan
  // the owner has already changed and cannot see they changed.

  /// The `sub_sched_…` attached to this subscription, so its events can be
  /// recognised and its effects cleared when it is released.
  stripeScheduleId String? @map("stripe_schedule_id")

  pendingPlan         SubscriptionPlan? @map("pending_plan")
  pendingPlanStartsAt DateTime?         @map("pending_plan_starts_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("subscriptions")
}

/// The one outstanding checkout link for an organization.
/// docs/phase-9-duplicate-subscription-prevention.md §4.
///
/// ## Why this is not a column on Subscription
///
/// Because at the moment a link is issued there is no Subscription row, and
/// that is the whole bug this table exists to fix. The row is written by
/// `activate()` when `checkout.session.completed` is processed — so a guard
/// that reads it is asking the payment path whether the payment path has
/// finished, and gets "no" for as long as the webhook is late. One tenant
/// reached three live Stripe subscriptions through that window.
///
/// This row is written *before* the customer is sent anywhere, so it exists
/// during exactly the interval in which nothing else does.
///
/// ## What `@unique` on tenantId buys
///
/// One outstanding link per organization, decided by PostgreSQL rather than by
/// a read-then-write in the service (rule 14). Two concurrent `POST /subscribe`
/// calls — the double-clicked button — produce one row and one link, and the
/// loser is told to use the winner's. Without it both would mint a link, and a
/// per-link limit of one completed session would then permit two payments.
///
/// The Stripe-side half of the same constraint is
/// `restrictions.completed_sessions.limit = 1` on the link itself, which is the
/// only guard actually standing on the path between the customer's browser and
/// Stripe's hosted page. Neither half is sufficient alone: this one stops two
/// links existing, that one stops one link being used twice.
model SubscriptionCheckoutLink {
  id String @id @default(cuid(2))

  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// What this link sells. A change of mind before paying deactivates the link
  /// in Stripe and replaces this row, rather than leaving two buyable links.
  plan SubscriptionPlan

  /// Whether this link was issued with a free trial, so the emailed copy and
  /// the screen can agree about whether anything is charged today.
  trial Boolean @default(false)

  /// `plink_…`. Kept so the link can be deactivated on a plan change, and so a
  /// customer stranded by a burnt link can be diagnosed without guessing.
  stripePaymentLinkId String @unique @map("stripe_payment_link_id")

  /// The URL as sent, `client_reference_id` and all. Stored rather than rebuilt
  /// so a second request returns the identical link — a regenerated URL that
  /// merely looks the same is a second link as far as Stripe is concerned.
  url String

  /// Set when `checkout.session.completed` is attributed to this link. The row
  /// is kept rather than deleted: "this organization already paid through this
  /// link" is the fact a duplicate investigation needs, and deleting it would
  /// make a burnt link indistinguishable from one that never existed.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("subscription_checkout_links")
}

/// Webhook idempotency. phase-9 §2.9.
///
/// Stripe delivers at-least-once and retries for days, so a handler that is not
/// idempotent eventually runs twice. The predecessor (`booking-for-all`) had no
/// table like this and acted on every delivery, which meant a redelivered
/// `checkout.session.completed` re-ran activation and re-sent notifications.
///
/// The primary key is Stripe's own event id: inserting is the claim, and a
/// duplicate key means another delivery already has it.
model StripeEvent {
  /// Stripe's `evt_…` id, not ours.
  id String @id

  type String

  payload Json @map("payload_json")

  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  lastError   String?   @map("last_error")

  @@index([processedAt])
  @@map("stripe_events")
}
