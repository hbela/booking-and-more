# syntax=docker/dockerfile:1
#
# Fastify API image. Also the image the one-shot `migrate` service runs — see
# docker-compose.coolify.yml and docs/phase-10-deployment-hetzner-coolify.md §3.
#
# Multi-stage, non-root, with a healthcheck. The predecessor project's images
# were single-stage `COPY . .` running as root with no healthcheck, which meant
# ~1 GB images and an orchestrator that could not tell a wedged process from a
# healthy one.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.api -t bam-api .

ARG NODE_VERSION=24-alpine

# --- build --------------------------------------------------------------------
FROM node:${NODE_VERSION} AS build
RUN corepack enable
WORKDIR /app

# pnpm's store lives where pnpm is told to put it, not where a cache mount
# happens to be mounted. Without this the mount below sits at a path pnpm never
# writes to, so every build re-downloaded the whole dependency graph while
# appearing to be cached.
ENV npm_config_store_dir=/pnpm/store

# The whole workspace, rather than a hand-listed set of package.json files.
#
# The listed form went stale the moment packages/auth, /availability-engine,
# /booking-engine and /notification-engine were added: `pnpm install
# --frozen-lockfile` refuses a lockfile naming workspace projects that are not
# on disk, so the image stopped building and nothing pointed at the missing
# manifest. Copying everything costs the separate install layer — a source edit
# now reinstalls — but the store mount makes that a relink rather than a
# download, and it cannot go stale again. .dockerignore already keeps
# node_modules, dist, .next and .env out.
COPY . .

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# `@bam/api...` is the app plus its workspace dependencies, which is what runs
# `prisma generate` — the API cannot build or boot without the generated client.
#
# The placeholder DATABASE_URL is not a default and must never become one. There
# is no database at image build time, and `prisma generate` does not want one —
# it reads schema.prisma. But prisma.config.ts throws when DATABASE_URL is
# unset, deliberately, because for a human at a terminal that is nearly always
# the actual mistake. Satisfying it inline keeps that error useful where it is
# useful and out of the way here; because it is set on this one command rather
# than as an ENV, it cannot leak into the runtime stage and be mistaken for
# configuration.
RUN DATABASE_URL=postgresql://build:build@127.0.0.1:5432/prisma_generate_does_not_connect \
    pnpm --filter @bam/api... --filter @bam/worker... build

# --- runtime ------------------------------------------------------------------
FROM node:${NODE_VERSION} AS api-runtime
RUN corepack enable
WORKDIR /app

ENV NODE_ENV=production

# `node` (uid 1000) ships with the base image; do not run as root.
USER node

COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
# The whole directory, because it carries packages/db/prisma/migrations and
# packages/db/prisma.config.ts. That is what makes `prisma migrate deploy`
# runnable from this image, and so lets the migration run in a container built
# from the same commit as the code that expects the schema.
COPY --from=build --chown=node:node /app/packages ./packages
COPY --from=build --chown=node:node /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=node:node /app/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=node:node /app/apps/api/node_modules ./apps/api/node_modules

EXPOSE 3001

# Liveness, not readiness: a database blip must not restart a healthy process.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/api/dist/server.js"]

# --- worker runtime -----------------------------------------------------------
#
# API and worker share almost their entire dependency graph, including the
# generated Prisma client. Building them from one stage matters on a small
# deployment host: separate Dockerfiles compile that large client twice in
# parallel, which can exhaust memory and turn a short typecheck into minutes of
# swapping. Separate runtime stages still keep both processes isolated.
FROM node:${NODE_VERSION} AS worker-runtime
RUN corepack enable
WORKDIR /app

ENV NODE_ENV=production

USER node

COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build --chown=node:node /app/packages ./packages
COPY --from=build --chown=node:node /app/apps/worker/dist ./apps/worker/dist
COPY --from=build --chown=node:node /app/apps/worker/package.json ./apps/worker/package.json
COPY --from=build --chown=node:node /app/apps/worker/node_modules ./apps/worker/node_modules

HEALTHCHECK --interval=60s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "process.exit(0)"

CMD ["node", "apps/worker/dist/worker.js"]

# Preserve the documented no-target build command: the default final image is
# still the API image.
FROM api-runtime AS api
