# syntax=docker/dockerfile:1
#
# Next.js web image, using `output: "standalone"` (see apps/web/next.config.ts)
# so the runtime stage carries only the traced server bundle.
#
# See docker/Dockerfile.api for why the whole workspace is copied rather than a
# list of manifests.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.web -t bam-web \
#     --build-arg NEXT_PUBLIC_API_BASE_URL=https://api.example.com .

ARG NODE_VERSION=24-alpine

# --- build --------------------------------------------------------------------
FROM node:${NODE_VERSION} AS build
RUN corepack enable
WORKDIR /app

ENV npm_config_store_dir=/pnpm/store

COPY . .

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so they
# must be present here rather than injected at run time. Changing the API's
# public origin therefore needs a rebuild, not a restart — and an image built
# with the wrong one produces a browser that calls the wrong host while the
# server-side half looks perfectly healthy.
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}

# @bam/web depends on @bam/contracts and @bam/availability-engine, neither of
# which reaches Prisma, so no placeholder DATABASE_URL is needed here.
RUN pnpm --filter @bam/web... build

# --- runtime ------------------------------------------------------------------
FROM node:${NODE_VERSION} AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

USER node

COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
