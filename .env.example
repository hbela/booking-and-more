# Copy to .env and fill in. Every variable here is validated by @bam/config at
# process start — a missing or malformed required value fails the boot loudly
# rather than surfacing as a confusing runtime error later.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# Public origin of the Next.js app. Also the only origin allowed by CORS.
APP_BASE_URL=http://localhost:3000
# Public origin of the Fastify API.
API_BASE_URL=http://localhost:3001
# Port the API binds to.
PORT=3001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Plain postgres URL. No Prisma Accelerate: the DATABASE_URL/DIRECT_URL split
# caused several production incidents in the predecessor project.
#
# The password is embedded here, so it must be URL-safe: generate real ones with
# `openssl rand -hex 32`, never `openssl rand -base64`. A `/` in the password
# ends the authority and the URL silently parses to a different host; @bam/config
# rejects that at boot. See docs/phase-10-deployment-hetzner-coolify.md §2.9.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_and_more?schema=public

# Used only by the integration test suite. Must be a DIFFERENT database — the
# suite truncates tables.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_and_more_test?schema=public

# ---------------------------------------------------------------------------
# Authentication (Epic 1)
# ---------------------------------------------------------------------------
# Better Auth signing secret. Must be >= 32 chars and stable across restarts —
# rotating it invalidates every live session.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google sign-in. Optional, but set BOTH or NEITHER: a half-configured provider
# fails at Google with an opaque error, so the config schema rejects it at boot.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Google Calendar sync (Epic 6, part 1). The SAME Google project as sign-in
# above — one client, one consent screen, one verification submission — so both
# variables above are needed as well as these two.
#
# The redirect URI must match what is registered in the Google console character
# for character. No default is derived from API_BASE_URL on purpose: a value
# that appears by itself is one nobody thought to register.
#   https://api.example.com/v1/integrations/google/callback
# GOOGLE_REDIRECT_URI=
#
# Seals refresh tokens at rest (tech-impl §25.2). 64 hex characters:
#   openssl rand -hex 32
# Hex, never base64 — see docs/phase-10 §2.9 for why a `/` in a generated
# secret is its own kind of afternoon. Rotating this strands every stored
# token and every provider has to reconnect.
# GOOGLE_TOKEN_ENCRYPTION_KEY=
#
# `calendar.events` is a Google SENSITIVE scope: until the app is verified it is
# capped at 100 connected users and shows an "unverified app" warning. See
# docs/phase-6-google-calendar-part-1.md §4.
#
# How long a pending OAuth state row stays usable (minutes).
# CALENDAR_OAUTH_STATE_TTL_MINUTES=15

# How long an invitation link stays usable (hours).
# INVITATION_EXPIRY_HOURS=168

# ---------------------------------------------------------------------------
# Queues and notifications (Epic 5)
# ---------------------------------------------------------------------------
# BullMQ's backing store. Unset, the worker idles and rate limiting uses an
# in-process store. Locally this is the `redis` service in docker/docker-compose.yml
# (give it a host port mapping first); in production prefer a rediss:// URL,
# since job payloads reference bookings and the people they belong to.
#
# The password goes in this URL and nowhere else. The compose files have a
# REDIS_PASSWORD variable — it is what `--requirepass` and this URL are both
# built from — but it stops there; nothing in the applications reads it.
# `openssl rand -hex 32`, for the same reason as DATABASE_URL above.
# REDIS_URL=redis://default:PASSWORD@localhost:6379

# Email delivery. Set BOTH or NEITHER — an API key with no sender address only
# fails once a job reaches Resend, asynchronously, one retry at a time.
# Unset, notifications are still recorded, and marked as undeliverable.
# RESEND_API_KEY=
# EMAIL_FROM="Booking and More <booking@example.com>"

# How many hours before a booking its reminder is sent.
# BOOKING_REMINDER_LEAD_HOURS=24

# Outbox dispatcher tuning (tech-impl §12). Defaults are fine for one worker.
# OUTBOX_POLL_INTERVAL_MS=5000
# OUTBOX_BATCH_SIZE=50
# OUTBOX_MAX_ATTEMPTS=5

# How often the sweep looks for notifications the queue does not have — reminders
# past the dispatcher's 15-minute horizon, and anything a Redis restart lost.
# NOTIFICATION_SWEEP_INTERVAL_MS=60000

# The same catch-up role for Google Calendar rows, plus the drain for the
# backfill that runs when a provider first connects. The batch size is the only
# throttle against Google's per-user rate limit.
# CALENDAR_SWEEP_INTERVAL_MS=60000
# CALENDAR_SWEEP_BATCH_SIZE=50

# Attempts before a calendar row is parked FAILED. Higher than the outbox's 5:
# a Google incident outlasts a database blip, and parking early means a
# provider's diary silently falls behind.
# CALENDAR_MAX_ATTEMPTS=8

# How many upcoming bookings are copied into a calendar the moment it is
# selected. Bounded because this is the one burst the feature generates; the
# soonest appointments are taken first.
# CALENDAR_BACKFILL_LIMIT=200

# ---------------------------------------------------------------------------
# Platform administration and billing (Epic 9)
# ---------------------------------------------------------------------------
# How long a newly provisioned organization has to subscribe before it is
# closed. Deliberately longer than INVITATION_EXPIRY_HOURS above.
# ONBOARDING_WINDOW_DAYS=14

# Stripe. Unset, the subscription screen says billing is unavailable and
# nothing else is affected. Set BOTH the key and the webhook secret — a key
# without one boots fine and sells fine, then cannot verify the event that says
# the customer paid, leaving them gated with a paid invoice against them.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#   locally: stripe listen --forward-to localhost:3001/v1/webhooks/stripe
#   prints the whsec_… to use here.

# A plan is its price. Required whenever STRIPE_SECRET_KEY is set, and now the
# only thing that decides what can be sold: the Payment Link is created from a
# price, per organization, at the moment the owner clicks subscribe
# (docs/phase-9-duplicate-subscription-prevention.md §4). A plan with no price
# here is simply not offered.
#
# The four STRIPE_PAYMENT_LINK_* variables that used to live here are gone. A
# link created once per plan is permanent, reusable and shared by every
# customer, so nothing on our side could stop one organization paying twice —
# an owner reopening an old email would check out again, and did. Links created
# per organization carry restrictions[completed_sessions][limit]=1, which Stripe
# enforces at checkout, and subscription_data[trial_period_days], which is what
# made the separate _NO_TRIAL links unnecessary.
#
# Nothing to create in the Stripe dashboard any more except the prices.
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PROFESSIONAL=price_...

# The free trial's length, in days. Told to Stripe when a link is created for an
# organization that has not used its trial, and shown on the screen before there
# is a subscription to read. Default 30.
# TRIAL_PERIOD_DAYS=30

# Error monitoring. Unset is fine locally; Sentry is simply not initialised.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Portfolio publishing (pnpm guide:publish) -----------------------------
# Pushes docs/user-guide.md to the my-blog portfolio. The secret must match
# IMPORT_API_SECRET on the TARGET site, not on this machine.
PORTFOLIO_API_URL=http://localhost:3000
PORTFOLIO_IMPORT_SECRET=
PORTFOLIO_PUBLIC_DIR=../my-blog/public
# Optional AI receptionist. Leave the key unset to keep chat disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
CHAT_MAX_OUTPUT_TOKENS=1024
CONVERSATION_TTL_MINUTES=1440
CONVERSATION_MAX_TURNS=40
PENDING_ACTION_TTL_SECONDS=300
