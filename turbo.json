{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",

  "concurrency": "16",

  "//": "globalDependencies + env are declared explicitly so the cache is actually correct. The predecessor repo (booking-for-all) declared neither, which made turbo hand back stale builds after env changes. `concurrency` is raised because `dev` is persistent in the three apps AND in every library (tsc --watch) — 11 tasks, over turbo's default of 10. Those library watches are why a new export appears in a running dev server: `^build` only compiles once at start-up, and the apps resolve each package through its `exports` map to dist/.",
  "globalDependencies": [
    ".env",
    "tsconfig.base.json",
    "packages/tsconfig/*.json",
    "pnpm-lock.yaml"
  ],
  "globalEnv": ["NODE_ENV", "CI"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["APP_BASE_URL", "API_BASE_URL", "DATABASE_URL", "SENTRY_DSN", "NEXT_PUBLIC_*"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },

    "@bam/db#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@bam/db#build"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:drift-check": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
